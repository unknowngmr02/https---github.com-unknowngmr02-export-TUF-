{
  "duration": 42.639,
  "phrases": [
    {
      "start": 0.099,
      "end": 1.139,
      "text": "So welcome back again."
    },
    {
      "start": 1.659,
      "end": 3.179,
      "text": "It's time to solve one more problem."
    },
    {
      "start": 3.559,
      "end": 6.259,
      "text": "Now in this problem, we need to evaluate sec square theta"
    },
    {
      "start": 6.839,
      "end": 8.079,
      "text": "minus ten square theta."
    },
    {
      "start": 8.519,
      "end": 10.019,
      "text": "This is not a calculation question."
    },
    {
      "start": 10.46,
      "end": 12.619,
      "text": "This is a direct identity question."
    },
    {
      "start": 13.159,
      "end": 16.02,
      "text": "So we only need to remember the standard trigonometric identity."
    },
    {
      "start": 16.899,
      "end": 18.799,
      "text": "We know that sec square theta"
    },
    {
      "start": 19.239,
      "end": 23.819,
      "text": "is equal to one plus ten square theta. Now move ten square theta to the other side."
    },
    {
      "start": 24.279,
      "end": 25.26,
      "text": "So sec square theta"
    },
    {
      "start": 25.659,
      "end": 27.019,
      "text": "minus ten square theta"
    },
    {
      "start": 27.579,
      "end": 28.739,
      "text": "is equal to one."
    },
    {
      "start": 29.039,
      "end": 30.939,
      "text": "That is exactly what the question is asking."
    },
    {
      "start": 31.379,
      "end": 31.659,
      "text": "Done."
    },
    {
      "start": 32.159,
      "end": 34.639,
      "text": "No value of theta is needed here."
    },
    {
      "start": 35.419,
      "end": 35.799,
      "text": "Hence,"
    },
    {
      "start": 36.219,
      "end": 39.759,
      "text": "sec square theta minus ten square theta is equal to one."
    },
    {
      "start": 40.2,
      "end": 42.639,
      "text": "So the correct option is option C."
    }
  ],
