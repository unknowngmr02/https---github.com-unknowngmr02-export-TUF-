  apt.emphasize(tl, "#building", 18.9);
  tl.fromTo("#adj-label", { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.35, ease: "back.out(1.4)" }, 21.58);
  apt.emphasize(tl, "#tri-base", 21.9);
  apt.emphasize(tl, "#angle-arc", 30.0);

  // PHASE 2 - Pin, then Given card
  const PIN_TIME = 30.5;
  const GIVEN_TIME = 31.3;

  apt.pinFlow(tl, "#q-full-card", "#q-pinned", PIN_TIME);
  apt.pinFlow(tl, "#illustration", "#illus-pinned", PIN_TIME);
  apt.fadeOut(tl, "#serial-num", PIN_TIME, 0.5);

  apt.cardEnter(tl, "#card-given .solution-card", GIVEN_TIME);
  apt.textReveal(tl, "#card-given .math");

  // STEP 1 - Given joins the stack; Step 1 enters.
  apt.morphToStack(tl, "#card-given .solution-card", "#stack-given .stack-card", 33.5);
  apt.cardEnter(tl, "#card-step1 .solution-card", 34.24);
  apt.textReveal(tl, "#card-step1 .math");

