  gsap.set("#angle-arc", { rotation: -31 });

  const tl = gsap.timeline({ paused: true });

  // PHASE 1 - Question entrance
  apt.questionEnter(tl, "#q-full-card", 0.3);
  apt.serialEnter(tl, "#serial-num", 0.8);

  // Illustration build - observer, ground line, sight line, building rise, arc, labels.
