  tl.to("#building", { attr: { height: 104, y: 116 }, duration: 0.7, ease: "power2.out" }, 10.7);
  tl.to("#right-angle", { opacity: 1, duration: 0.3 }, 11.2);
  tl.to("#angle-arc", { opacity: 1, duration: 0.3 }, 11.5);
  tl.to("#theta-label", { opacity: 1, duration: 0.3 }, 11.7);
  tl.to("#base-label", { opacity: 1, duration: 0.3 }, 12.0);

  // "h = ?" (Scene 3)
  tl.fromTo("#h-label", { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: 0.35, ease: "back.out(1.4)" }, 15.26);
  apt.emphasize(tl, "#building", 15.6);

  // "Opposite" / "Adjacent" labels (Scene 4)
